# Образец. Настоящие значения кладите в .env.local — он в .gitignore.
# Сюда реальные ключи не вписывайте.
#
# Supabase → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...   # публичный ключ, попадает в браузер — это нормально
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...            # секретный, ТОЛЬКО на сервере, никогда в NEXT_PUBLIC_

# Приложение
NEXT_PUBLIC_SITE_URL=https://unik-tap.vercel.app
REVALIDATE_SECRET=случайная-строка-32-символа
